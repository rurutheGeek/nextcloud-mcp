# Copy to .env and edit. Every value is optional, but Nextcloud must be
# reachable at NEXTCLOUD_MCP_BASE_URL.

# Address the server binds inside the container. Keep 0.0.0.0 here and publish
# only the host loopback in compose.yaml.
NEXTCLOUD_MCP_BIND=0.0.0.0

# Listening port. Only change it together with the compose port mapping.
#NEXTCLOUD_MCP_PORT=5811

# Nextcloud URL. 127.0.0.1 works only when Nextcloud runs in the same network
# namespace; with Docker use a name or address reachable from the container,
# for example https://cloud.example.net
NEXTCLOUD_MCP_BASE_URL=http://127.0.0.1:8080

# Music tag API bridge (optional). The three tag tools are advertised and
# usable only when BOTH values are set. The API must accept a bearer token and
# answer GET/POST /tags plus GET /musicbrainz with library-relative paths.
#NEXTCLOUD_MCP_TAG_API_URL=http://127.0.0.1:5810
#NEXTCLOUD_MCP_TAG_API_TOKEN=change-me

# Music library root inside the Nextcloud account. The MP3 tag tools accept
# only .mp3 files under this path, and {root}/Converted stays write-protected.
NEXTCLOUD_MCP_MUSIC_ROOT=/music

# Timezone for calendar times that carry no UTC offset, for all-day events and
# for the default list range. Empty uses the host's local timezone; set an
# IANA name (for example Asia/Tokyo) when the host runs in UTC but the users
# do not.
#NEXTCLOUD_MCP_TIMEZONE=Asia/Tokyo

# Extra write-deny prefixes, comma-separated absolute paths. They are refused
# by every write tool (and so are their ancestors, so a protected subtree
# cannot be moved or deleted with its parent); read tools still work.
#NEXTCLOUD_MCP_WRITE_DENY=/inbox/quarantine,/backups

# Optional Origin allow-list, comma-separated (scheme + host + port). When
# set, requests carrying an Origin header must match one entry exactly.
# When unset, a present Origin must match the Host header; requests without an
# Origin (server-to-server clients) are always allowed. Recommended when a
# browser-based MCP client is used.
#NEXTCLOUD_MCP_ALLOWED_ORIGINS=https://nextcloud-mcp.example.net

# Scratch space for archive downloads and extractions. Use a directory on disk
# (not tmpfs) when extracting multi-GB archives.
#NEXTCLOUD_MCP_TMP=/var/tmp/nextcloud-mcp

# 1 hides every write tool from tools/list and refuses write calls.
NEXTCLOUD_MCP_READ_ONLY=0

# Limits in bytes unless noted (zip-bomb protection).
#NEXTCLOUD_MCP_MAX_READ_BYTES=262144
#NEXTCLOUD_MCP_MAX_WRITE_BYTES=8388608
#NEXTCLOUD_MCP_MAX_BODY_BYTES=33554432
#NEXTCLOUD_MCP_MAX_EXTRACT_FILES=10000
#NEXTCLOUD_MCP_MAX_EXTRACT_BYTES=4294967296
#NEXTCLOUD_MCP_MAX_ZIP_BYTES=4294967296

# HTTP timeouts in seconds. Archive transfers use the archive timeout.
#NEXTCLOUD_MCP_TIMEOUT=120
#NEXTCLOUD_MCP_ARCHIVE_TIMEOUT=1800

# Authentication: basic (default), oauth or both.
#   basic  forward the caller's Basic credential (user + app password).
#   oauth  MCP OAuth 2.1 login through Nextcloud's built-in OAuth2 app.
#   both   accept either; useful while moving clients over.
# oauth and both need the packages in requirements-oauth.txt (the Docker
# image has them) and the four values below.
#NEXTCLOUD_MCP_AUTH=basic

# Public HTTPS URL of this server, without /mcp. Register
# <this URL>/auth/callback as the redirect URI of an OAuth2 client in
# Nextcloud (Administration settings -> Security -> OAuth 2.0 clients).
#NEXTCLOUD_MCP_PUBLIC_URL=https://nextcloud-mcp.example.net

# Nextcloud URL as seen by the users' browsers, when it differs from
# NEXTCLOUD_MCP_BASE_URL (for example when BASE_URL is an internal address).
#NEXTCLOUD_MCP_NEXTCLOUD_PUBLIC_URL=https://cloud.example.net

# The client identifier and secret Nextcloud shows for that OAuth2 client.
#NEXTCLOUD_MCP_OAUTH_CLIENT_ID=
#NEXTCLOUD_MCP_OAUTH_CLIENT_SECRET=

# Optional allow-list of MCP client redirect URIs, comma-separated, wildcards
# allowed. Empty accepts the URIs a client registers, loopback ports may vary.
#NEXTCLOUD_MCP_OAUTH_REDIRECT_URIS=http://127.0.0.1:*/mcp/oauth/callback

# Where client registrations and the (encrypted) Nextcloud tokens are kept.
# Must persist across restarts, or every user has to log in again.
#NEXTCLOUD_MCP_STATE_DIR=/var/lib/nextcloud-mcp
